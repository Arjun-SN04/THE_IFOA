      date: 'Issue #14 • Fall 2024',
      author: 'Aviation Compliance Editorial Team',
      readTime: '8 min read'
    },
    {
      id: 2,
      category: 'operations',
      categoryLabel: 'OCC Operations',
      title: 'Real-Time Diversion Decision Making Under Severe North Atlantic Turbulence',
      snippet: 'How dispatchers at major European carriers coordinate with oceanic control to re-route wide-body jets safely without fuel penalties.',
      date: 'Issue #14 • Fall 2024',
      author: 'Capt. Thomas Weber & Senior Dispatchers',
      readTime: '12 min read'
    },
    {
      id: 3,
      category: 'tech',
      categoryLabel: 'Next-Gen Technology',
      title: 'AI in Flight Planning: Augmenting the Human Dispatcher',
      snippet: 'Evaluating automated trajectory calculators against real human dispatcher intuition during weather chaos and ground stop delays.',
      date: 'Issue #13 • Summer 2024',
      author: 'IFOA Flight Technology Lab',
      readTime: '6 min read'
    },
    {
      id: 4,
      category: 'interviews',
      categoryLabel: 'Leadership Focus',
      title: 'Behind the Scenes at DHL Austria OCC: Interview with Filipe Sanches',
      snippet: 'How DHL coordinates European cargo dispatch networks with zero tolerance for delays and rigorous training quality standards.',
      date: 'Issue #13 • Summer 2024',
      author: 'Foxtrot Delta Editorial',
      readTime: '10 min read'
    },
    {
      id: 5,
      category: 'safety',
      categoryLabel: 'Human Factors',
      title: 'Fatigue Risk Management in 24/7 Shift Operations',
      snippet: 'Proven strategies for shift rotas, cognitive alertness preservation, and circadian support in high-stress OCC control rooms.',
      date: 'Issue #12 • Spring 2024',
      author: 'Dr. Elena Rossi, Aviation Human Factors',
      readTime: '9 min read'
    },
    {
      id: 6,
      category: 'regulations',
      categoryLabel: 'FAA Updates',
      title: 'FAA 14 CFR Part 3 Agent for Service Mandate Explained',
